# Copy to .env for local builds, and set the same variables in Vercel → Project → Settings → Environment Variables.

# Production URL, used for canonical links, OG tags and share links. No trailing slash.
PUBLIC_SITE_URL=https://www.howyourcitymoves.fyi

# Analytics: plausible | posthog | none
PUBLIC_ANALYTICS_PROVIDER=plausible
PUBLIC_PLAUSIBLE_DOMAIN=www.howyourcitymoves.fyi
# Must be Plausible's *manual* script (pageviews are sent by the app). Change for self-hosted Plausible.
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.manual.js

# PostHog (only read when PUBLIC_ANALYTICS_PROVIDER=posthog)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Events go through this site's /ingest path (vercel.json rewrites it to PostHog). Set to "off" to send
# straight to PUBLIC_POSTHOG_HOST. If your project is in the EU, change the rewrites in vercel.json to eu.
PUBLIC_POSTHOG_PROXY=

# Set to 1 to send real events from `npm run dev` (normally dev only logs to the console).
PUBLIC_ANALYTICS_IN_DEV=

# Supabase city-wide stats. Leave empty to hide the opt-in entirely.
# Use the publishable (anon) key: it is designed to be public.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Only for GitHub Pages project sites, e.g. /how-bangalore-moves
BASE_PATH=
