---
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "@fontsource/geist/latin-600.css";
import "@fontsource/geist-mono/latin-400.css";
import "@fontsource/geist-mono/latin-500.css";
import geist400 from "@fontsource/geist/files/geist-latin-400-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/base.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SharePopover from "../components/SharePopover.astro";
import { SITE } from "../config";
import { href } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  /** Home page: no site header bar, the hero carries the name. */
  home?: boolean;
  noindex?: boolean;
  /** Extra schema.org nodes for this page (merged into the site-wide JSON-LD graph). */
  jsonLd?: Record<string, unknown>[];
  /** City map pages: which city, read by the app at load. */
  city?: string;
  /** The whole <title>, used as is (city pages: "How Pune moves"). */
  pageTitle?: string;
  /** Link-preview image path and its description. */
  ogImage?: string;
  ogAlt?: string;
}
const { title, description = SITE.description, home = false, noindex = false, jsonLd = [], city, pageTitle,
  ogImage: ogPath = "/og.png", ogAlt = "An isometric line drawing of city landmarks on a charcoal background, with commuters moving between them." } = Astro.props;
const fullTitle = pageTitle ?? (title ? `${title} · ${SITE.name}` : SITE.name);
const shareTitle = pageTitle ?? title ?? SITE.name;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), SITE.url).toString();
const ogImage = new URL(href(ogPath), SITE.url).toString();
// Structured data so search engines and AI agents can tell what the site is and who made it
const person = { "@type": "Person", "@id": `${SITE.url}/about#person`, name: SITE.owner, url: `${SITE.url}/about`, jobTitle: "Product manager",
  homeLocation: { "@type": "Place", name: "Bengaluru, India" }, sameAs: [SITE.linkedin, SITE.repo.replace(/\/[^/]+$/, "")] };
const ld = { "@context": "https://schema.org", "@graph": [
  { "@type": "WebSite", "@id": `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, description: SITE.description, inLanguage: "en-IN", publisher: { "@id": person["@id"] } },
  { "@type": "WebPage", url: canonical, name: shareTitle, description, isPartOf: { "@id": `${SITE.url}/#website` }, inLanguage: "en-IN" },
  person,
  ...jsonLd,
] };
---
<!doctype html>
<html lang="en-IN" data-city={city}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#2a2a2d" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#d6d1c6" media="(prefers-color-scheme: light)" />
  <meta name="color-scheme" content="dark light" />
  <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  <link rel="icon" href={href("/favicon-32.png")} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
  <link rel="preload" href={geist400} as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={shareTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogAlt} />
  <link rel="sitemap" type="application/xml" href={href("/sitemap.xml")} />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {!home && <SiteHeader />}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
  <SharePopover />
  <script>
    import "../lib/site";
  </script>
</body>
</html>
