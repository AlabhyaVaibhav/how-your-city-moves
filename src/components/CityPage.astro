---
/* One city's map page. `/` is Bangalore's; `/[city]` renders the rest. */
import Base from "../layouts/Base.astro";
import Brackets from "./Brackets.astro";
import ShareIcon from "./ShareIcon.astro";
import "../styles/app.css";
import { SITE } from "../config";
import { href } from "../lib/paths";
import { MODES, MODE_IDS } from "../app/modes";
import { CITIES, CITY_IDS, DEFAULT_CITY, type CityId } from "../cities";
import { cityPath } from "../app/city";

interface Props { city: CityId }
const { city } = Astro.props;
const C = CITIES[city];
const areas = Object.values(C.areas) as { label: string }[];
const heading = C.title ?? `How ${C.name} moves`;
const path = city === DEFAULT_CITY ? "/" : `/${city}`;
const description = `Watch ${C.name} commute: tell it when people leave home, where they go and how long the ride takes, and the city steps forward every half hour, all day, on a loop.`;
const app = {
  "@type": "WebApplication", name: heading, url: SITE.url + path, description,
  applicationCategory: "VisualizationApplication", operatingSystem: "Any (web browser)", isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "INR" }, author: { "@id": `${SITE.url}/about#person` },
  about: { "@type": "City", name: C.official, alternateName: C.name, containedInPlace: { "@type": "Country", name: C.country } },
  spatialCoverage: areas.map(n => ({ "@type": "Place", name: `${n.label}, ${C.official}` })),
};
const og = city === DEFAULT_CITY ? "/og.png" : `/og/${city}.png`;
---
<Base home city={city} pageTitle={heading} description={description} ogImage={og} ogAlt={`An isometric line drawing of ${C.name} landmarks on a charcoal background, with commuters moving between them.`} jsonLd={[app]}>
<div class="wrap">
  <header class="head">
    <div>
      <h1 id="siteName">{heading}</h1>
      <p>{SITE.description}</p>
    </div>
    <details class="city-pick" id="cityPick" hidden={CITY_IDS.length < 2}>
      <summary class="city-btn" aria-label={`City: ${C.name}. Choose another city`}>
        <img src={href(`/city/${city}.svg`)} alt="" width="34" height="34" />
        <span class="city-now"><small>City</small><b>{C.name}</b></span>
        <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <nav class="city-panel" aria-label="Cities">
        <p class="city-panel-head">Pick a city</p>
        <ul>
          {CITY_IDS.map(id => (
            <li><a href={href(cityPath(id))} data-city={id} aria-current={id === city ? "page" : undefined}>
              <img src={href(`/city/${id}.svg`)} alt="" width="56" height="56" />
              <b>{CITIES[id].name}</b>
              <small>{Object.keys(CITIES[id].areas).length} areas</small>
            </a></li>
          ))}
        </ul>
      </nav>
    </details>
  </header>

  <noscript>
    <p class="noscript">This interactive map needs JavaScript. It animates commuters moving between {C.official} neighbourhoods ({areas.map(n => n.label).join(", ")}) across a day, in 30-minute steps. A plain-text summary is at <a href={href("/llms.txt")}>/llms.txt</a>.</p>
  </noscript>

  <section class="timebar" aria-label="Time of day">
    <div class="tb-time"><span class="t" id="clock">09:00</span><span class="d" id="day">day 1</span></div>
    <div class="track" id="track">
      <div class="density" id="density"></div>
      <div class="baseline"></div>
      <div class="hours" id="hours" aria-hidden="true"></div>
      <div class="now" id="now"><i class="knob"></i></div>
      <input class="track-input" type="range" id="scrub" min="0" max="1439" step="1" value="540" aria-label="Time of day" />
    </div>
    <div class="tb-ctrl">
      <button class="play" id="play" type="button" aria-label="Pause"></button>
      <label class="sl"><span>speed</span><input type="range" id="speed" min="200" max="1900" step="50" value="1150" aria-label="Playback speed" /></label>
    </div>
  </section>

  <section class="grid" aria-label="The city">
    <article class="card map-card" data-tilt="1.2">
      <div class="card-head"><h2>The city, right now</h2>
        <div class="head-r">
          <button class="cta" id="openAdd" type="button"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Add yourself</button>
          <button class="pill" id="realMap" type="button" aria-pressed="false"><svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 3.5 5 2l4 1.5L13 2v8.5L9 12l-4-1.5L1 12Z M5 2v8.5 M9 3.5V12" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>Real map</button>
          <button class="pill" type="button" data-share="map"><ShareIcon />Share</button>
          <span class="num" aria-hidden="true">001</span>
        </div>
      </div>
      <div class="frame">
        <Brackets />
        <svg id="map" viewBox="0 10 1200 770" role="img" aria-label={`Isometric map of ${C.name} landmarks with commuters moving between them`}></svg>
      </div>
      <div class="foot"><span class="on-yours"><span class="on-hover">Hover a neighbourhood to see who's there, or a name in the list to follow one person.</span><span class="on-touch">Tap a neighbourhood to see who's there, or a name in the list to follow one person.</span></span><span class="on-everyone">The whole city on the move, with your commuters in cream. <span class="on-hover">Hover</span><span class="on-touch">Tap</span> a neighbourhood to see who's there, or a name in the list to follow one person.</span></div>
    </article>

    <article class="card" data-tilt="5">
      <div class="card-head"><h2>Rush hours</h2>
        <span class="num" aria-hidden="true">002</span>
      </div>
      <div class="frame">
        <Brackets />
        <svg id="bars" viewBox="0 0 320 320" aria-hidden="true"></svg>
      </div>
      <div class="foot" id="barsFoot" aria-live="polite"></div>
    </article>

    <article class="card" data-tilt="5">
      <div class="card-head"><h2>Where everyone is</h2><span class="num" aria-hidden="true">003</span></div>
      <div class="frame">
        <Brackets />
        <svg id="pie" viewBox="0 0 320 250" aria-hidden="true"></svg>
      </div>
      <div class="tally" id="tally">
        <button type="button" data-k="home"><b>0</b><small>at home</small></button>
        <button type="button" data-k="transit"><b>0</b><small>on the road</small></button>
        <button type="button" data-k="office"><b>0</b><small>at work</small></button>
      </div>
    </article>

    <article class="card list-card">
      <div class="card-head"><h2>In the city</h2><span class="num" aria-hidden="true">004</span></div>
      <div class="list-head"><span id="countNote"></span><label class="switch"><input type="checkbox" id="showNames" checked /><i></i><span>Show names</span></label></div>
      <div class="list-body">
        <div id="routesBox" hidden>
          <p class="list-label">Busiest routes</p>
          <ul class="routes" id="routes" aria-label="Busiest routes across the city"></ul>
        </div>
        <div id="modesBox" hidden>
          <p class="list-label">How people get there</p>
          <ul class="routes" id="modes" aria-label="How people across the city get to work"></ul>
        </div>
        <p class="list-label" id="yoursLabel" hidden>Yours</p>
        <ul class="people" id="people" aria-label="Your commuters"></ul>
      </div>
      <button class="resetlink" id="reset" type="button">Reset to sample commuters</button>
    </article>
  </section>
</div>

<dialog class="sheet" id="addDlg" aria-labelledby="addTitle">
  <div class="card-head"><h2 id="addTitle">Add yourself</h2><button class="x close" id="closeAdd" type="button" aria-label="Close">×</button></div>
  <form class="form" id="form">
    <div class="field"><label for="fName">Your name (optional)</label><input id="fName" placeholder="Leave blank for a random one" autocomplete="off" maxlength="40" enterkeyhint="done" /></div>
    <div class="pair">
      <div class="field"><label for="fHome">Lives in</label><select id="fHome"></select></div>
      <div class="field"><label for="fOffice">Works in</label><select id="fOffice"></select></div>
    </div>
    <div class="pair">
      <div class="field"><label for="fOut">Leaves home</label><input type="time" id="fOut" value="09:00" /></div>
      <div class="field"><label for="fBack">Leaves work</label><input type="time" id="fBack" value="18:30" /></div>
    </div>
    <div class="pair">
      <div class="field"><label for="fMode">Gets there by</label><select id="fMode" required><option value="" disabled selected>Pick one</option>{MODE_IDS.map(m => <option value={m}>{MODES[m]}</option>)}</select></div>
      <div class="field"><label for="fMins">One way (minutes)</label><input type="number" id="fMins" value="45" min="5" max="180" inputmode="numeric" /></div>
    </div>
    <div id="fShareRow">
      <label class="check"><input type="checkbox" id="fShare" />
        <span>Add me to the city-wide stats
          <small>Sends your areas, how you get there and rounded times anonymously. Never your name. <a href={href("/privacy#city-stats")}>What's shared</a></small>
        </span>
      </label>
    </div>
    <button class="add" type="submit">Add yourself</button>
  </form>
</dialog>

<dialog class="sheet card-sheet" id="cardDlg" aria-labelledby="cardTitle">
  <div class="card-head"><h2 id="cardTitle">Your commute card</h2><button class="x close" id="closeCard" type="button" aria-label="Close">×</button></div>
  <p class="card-lede" id="cardLede"></p>
  <div class="card-img"><img id="cardImg" alt="" width="1200" height="630" /></div>
  <div class="card-actions">
    <button class="cta" id="cardShare" type="button"><ShareIcon />Share image</button>
    <button class="pill" id="cardDownload" type="button">Download</button>
    <a class="pill" data-card="x" href="https://x.com/" target="_blank" rel="noopener noreferrer">Post on X<span class="sr-only"> (opens in a new tab)</span></a>
    <a class="pill" data-card="linkedin" href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
    <a class="pill" data-card="whatsapp" href="https://wa.me/" target="_blank" rel="noopener noreferrer">WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>
    <button class="pill" id="cardCopy" type="button">Copy text</button>
  </div>
  <p class="card-note">Made in your browser; nothing is uploaded. On X and LinkedIn, download it first and attach it to your post.</p>
  <p class="share-status" id="cardStatus" role="status" aria-live="polite"></p>
</dialog>
</Base>

<script>
  import "../app/main";
</script>
